{
  "name": "nuxt-vitals-panel",
  "version": "0.1.0",
  "description": "A small flame button that opens a live Core Web Vitals panel on any Nuxt page. Copy the report, show it to admins only in production.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "web-vitals",
    "performance",
    "lcp",
    "cls",
    "inp",
    "devtools",
    "tailwindcss"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kendrick-k/nuxt-vitals-panel.git"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "web-vitals": "^5.0.0"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "nuxt": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "nuxt": "^3.15.0 || ^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
